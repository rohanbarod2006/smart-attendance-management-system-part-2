rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function matchesAuthEmail(email) {
      return email is string
        && email.size() >= 3
        && email.size() <= 160
        && request.auth.token.email is string
        && email.lower() == request.auth.token.email.lower();
    }

    function hasNoLegacyApprovalFields(data) {
      return !('approvalStatus' in data)
        && !('rejectionReason' in data)
        && !('reviewedBy' in data)
        && !('reviewedByEmail' in data)
        && !('reviewedAt' in data)
        && !('approvedBy' in data)
        && !('approvedAt' in data)
        && !('rejectedBy' in data)
        && !('rejectedAt' in data);
    }

    function isValidStudentUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'created_at'])
        && data.keys().hasOnly(['id', 'name', 'email', 'role', 'roll_number', 'created_at'])
        && data.id is string
        && data.id == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && matchesAuthEmail(data.email)
        && data.role == 'student'
        && (!('roll_number' in data) || data.roll_number == null || (data.roll_number is string && data.roll_number.size() <= 50))
        && data.created_at is string
        && data.created_at.size() >= 10
        && data.created_at.size() <= 40;
    }

    function isValidTeacherUser(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'collegeName',
          'department',
          'facultyId',
          'designation',
          'role',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'collegeName',
          'department',
          'facultyId',
          'designation',
          'role',
          'createdAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && matchesAuthEmail(data.email)
        && data.collegeName is string
        && data.collegeName.size() >= 1
        && data.collegeName.size() <= 150
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 120
        && data.facultyId is string
        && data.facultyId.size() >= 1
        && data.facultyId.size() <= 60
        && data.designation is string
        && data.designation.size() >= 1
        && data.designation.size() <= 100
        && data.role == 'teacher'
        && data.createdAt is string
        && data.createdAt.size() >= 10
        && data.createdAt.size() <= 40;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isValidTeacherClass(data) {
      return data.keys().hasAll([
          'className',
          'subjectName',
          'subjectCode',
          'department',
          'academicYear',
          'semester',
          'teacherUid',
          'teacherName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'className',
          'subjectName',
          'subjectCode',
          'department',
          'academicYear',
          'semester',
          'teacherUid',
          'teacherName',
          'createdAt',
          'updatedAt'
        ])
        && data.className is string
        && data.className.size() >= 1
        && data.className.size() <= 100
        && data.subjectName is string
        && data.subjectName.size() >= 1
        && data.subjectName.size() <= 120
        && data.subjectCode is string
        && data.subjectCode.size() >= 1
        && data.subjectCode.size() <= 30
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 120
        && data.academicYear is string
        && data.academicYear.size() >= 1
        && data.academicYear.size() <= 30
        && data.semester is string
        && data.semester.size() >= 1
        && data.semester.size() <= 30
        && data.teacherUid is string
        && data.teacherUid == request.auth.uid
        && data.teacherName is string
        && data.teacherName.size() >= 1
        && data.teacherName.size() <= 120
        && data.createdAt is string
        && data.createdAt.size() >= 10
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() >= 10
        && data.updatedAt.size() <= 40;
    }

    function isValidSessionBase(data) {
      return data.teacherUid is string
        && data.teacherUid == request.auth.uid
        && data.teacherName is string
        && data.teacherName.size() >= 1
        && data.teacherName.size() <= 120
        && isValidId(data.classId)
        && data.className is string
        && data.className.size() >= 1
        && data.className.size() <= 100
        && data.subjectName is string
        && data.subjectName.size() >= 1
        && data.subjectName.size() <= 120
        && data.subjectCode is string
        && data.subjectCode.size() >= 1
        && data.subjectCode.size() <= 30
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 120
        && data.startTime is string
        && data.startTime.size() >= 10
        && data.startTime.size() <= 40
        && data.expiryTime is string
        && data.expiryTime.size() >= 10
        && data.expiryTime.size() <= 40
        && data.expiryTimestamp is timestamp
        && data.durationMinutes is number
        && data.durationMinutes >= 1
        && data.durationMinutes <= 180
        && data.createdAt is string
        && data.createdAt.size() >= 10
        && data.createdAt.size() <= 40;
    }

    function isValidNewSession(data) {
      return data.keys().hasAll([
          'teacherUid',
          'teacherName',
          'classId',
          'className',
          'subjectName',
          'subjectCode',
          'department',
          'startTime',
          'expiryTime',
          'expiryTimestamp',
          'durationMinutes',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'teacherUid',
          'teacherName',
          'classId',
          'className',
          'subjectName',
          'subjectCode',
          'department',
          'startTime',
          'expiryTime',
          'expiryTimestamp',
          'durationMinutes',
          'status',
          'createdAt'
        ])
        && isValidSessionBase(data)
        && data.status == 'ACTIVE';
    }

    function isValidSessionUpdate(data) {
      return data.keys().hasAll([
          'teacherUid',
          'teacherName',
          'classId',
          'className',
          'subjectName',
          'subjectCode',
          'department',
          'startTime',
          'expiryTime',
          'expiryTimestamp',
          'durationMinutes',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'teacherUid',
          'teacherName',
          'classId',
          'className',
          'subjectName',
          'subjectCode',
          'department',
          'tokenHash',
          'startTime',
          'expiryTime',
          'expiryTimestamp',
          'durationMinutes',
          'status',
          'createdAt'
        ])
        && isValidSessionBase(data)
        && data.status in ['ACTIVE', 'CLOSED', 'EXPIRED']
        && (!('tokenHash' in data) || (data.tokenHash is string && data.tokenHash.size() == 64));
    }

    function isValidSessionSecret(data, sessionId) {
      return data.keys().hasAll(['sessionId', 'teacherUid', 'tokenHash', 'createdAt'])
        && data.keys().hasOnly(['sessionId', 'teacherUid', 'tokenHash', 'createdAt'])
        && data.sessionId is string
        && data.sessionId == sessionId
        && data.teacherUid is string
        && data.teacherUid == request.auth.uid
        && data.tokenHash is string
        && data.tokenHash.size() == 64
        && data.tokenHash.matches('^[a-f0-9]{64}$')
        && data.createdAt is string
        && data.createdAt.size() >= 10
        && data.createdAt.size() <= 40;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
          'sessionId',
          'classId',
          'className',
          'subjectName',
          'subjectCode',
          'teacherUid',
          'teacherName',
          'studentUid',
          'studentName',
          'studentEmail',
          'qrToken',
          'markedAt',
          'markedAtTimestamp',
          'status'
        ])
        && data.keys().hasOnly([
          'sessionId',
          'classId',
          'className',
          'subjectName',
          'subjectCode',
          'teacherUid',
          'teacherName',
          'studentUid',
          'studentName',
          'studentEmail',
          'rollNumber',
          'qrToken',
          'markedAt',
          'markedAtTimestamp',
          'status'
        ])
        && isValidId(data.sessionId)
        && isValidId(data.classId)
        && data.className is string
        && data.className.size() >= 1
        && data.className.size() <= 100
        && data.subjectName is string
        && data.subjectName.size() >= 1
        && data.subjectName.size() <= 120
        && data.subjectCode is string
        && data.subjectCode.size() >= 1
        && data.subjectCode.size() <= 30
        && isValidId(data.teacherUid)
        && data.teacherName is string
        && data.teacherName.size() >= 1
        && data.teacherName.size() <= 120
        && data.studentUid is string
        && data.studentUid == request.auth.uid
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 120
        && matchesAuthEmail(data.studentEmail)
        && (!('rollNumber' in data) || data.rollNumber == null || (data.rollNumber is string && data.rollNumber.size() <= 50))
        && data.qrToken is string
        && data.qrToken.size() >= 16
        && data.qrToken.size() <= 128
        && data.markedAt is string
        && data.markedAt.size() >= 10
        && data.markedAt.size() <= 40
        && data.markedAtTimestamp == request.time
        && data.status == 'PRESENT';
    }

    function verifyAttendanceSessionAndToken(data) {
      let sessionDoc = get(/databases/$(database)/documents/sessions/$(data.sessionId));
      let secretDoc = get(/databases/$(database)/documents/sessionSecrets/$(data.sessionId));
      return sessionDoc.data.status == 'ACTIVE'
        && request.time <= sessionDoc.data.expiryTimestamp
        && hashing.sha256(data.qrToken.toUtf8()).toHexString().lower() == secretDoc.data.tokenHash
        && data.teacherUid == sessionDoc.data.teacherUid
        && data.classId == sessionDoc.data.classId
        && data.className == sessionDoc.data.className
        && data.subjectName == sessionDoc.data.subjectName
        && data.subjectCode == sessionDoc.data.subjectCode
        && data.teacherName == sessionDoc.data.teacherName;
    }

    match /users/{userId} {
      // Users can read only their own profile; listing all users is disabled.
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      // Public registration may create only the caller's own profile as 'student' or 'teacher'.
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && (
          isValidStudentUser(incoming()) ||
          isValidTeacherUser(incoming())
        );

      // Users cannot modify their role, id/uid, email, or created timestamp.
      // Existing teacher profiles may safely drop legacy approval fields during login migration.
      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && (
          (
            existing().role == 'student'
            && isValidStudentUser(incoming())
            && incoming().id == existing().id
            && incoming().role == existing().role
            && incoming().email == existing().email
            && incoming().created_at == existing().created_at
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'roll_number'])
          ) || (
            existing().role == 'teacher'
            && isValidTeacherUser(incoming())
            && hasNoLegacyApprovalFields(incoming())
            && incoming().uid == existing().uid
            && incoming().role == existing().role
            && incoming().email == existing().email
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'collegeName',
              'department',
              'facultyId',
              'designation',
              'approvalStatus',
              'rejectionReason',
              'reviewedBy',
              'reviewedByEmail',
              'reviewedAt',
              'approvedBy',
              'approvedAt',
              'rejectedBy',
              'rejectedAt'
            ])
          )
        );

      allow delete: if false;
    }

    match /classes/{classId} {
      // Teachers can manage only their own classes.
      allow get: if isValidId(classId) && isTeacher() && existing().teacherUid == request.auth.uid;
      allow list: if isTeacher() && existing().teacherUid == request.auth.uid;

      allow create: if isValidId(classId)
        && isTeacher()
        && isValidTeacherClass(incoming())
        && incoming().teacherUid == request.auth.uid;

      allow update: if isValidId(classId)
        && isTeacher()
        && existing().teacherUid == request.auth.uid
        && isValidTeacherClass(incoming())
        && incoming().teacherUid == existing().teacherUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'className',
          'subjectName',
          'subjectCode',
          'department',
          'academicYear',
          'semester',
          'teacherName',
          'updatedAt'
        ]);

      allow delete: if isValidId(classId)
        && isTeacher()
        && existing().teacherUid == request.auth.uid;
    }

    match /sessions/{sessionId} {
      // Public session metadata only — tokenHash is stored separately in sessionSecrets.
      allow get: if isValidId(sessionId) && isSignedIn();
      allow list: if isSignedIn() && (
        (isTeacher() && existing().teacherUid == request.auth.uid) ||
        isStudent()
      );

      allow create: if isValidId(sessionId)
        && isTeacher()
        && isValidNewSession(incoming())
        && incoming().teacherUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/sessionSecrets/$(sessionId))
        && getAfter(/databases/$(database)/documents/sessionSecrets/$(sessionId)).data.teacherUid == request.auth.uid;

      allow update: if isValidId(sessionId)
        && isTeacher()
        && existing().teacherUid == request.auth.uid
        && isValidSessionUpdate(incoming())
        && incoming().teacherUid == existing().teacherUid
        && incoming().classId == existing().classId
        && incoming().startTime == existing().startTime
        && incoming().expiryTime == existing().expiryTime
        && incoming().expiryTimestamp == existing().expiryTimestamp
        && incoming().durationMinutes == existing().durationMinutes
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow delete: if isValidId(sessionId)
        && isTeacher()
        && existing().teacherUid == request.auth.uid;
    }

    match /sessionSecrets/{sessionId} {
      // Strictly unreadable by students; stores SHA-256 tokenHash for server-side rule verification.
      allow get: if isValidId(sessionId)
        && isTeacher()
        && existing().teacherUid == request.auth.uid;
      allow list: if false;

      allow create: if isValidId(sessionId)
        && isTeacher()
        && isValidSessionSecret(incoming(), sessionId)
        && existsAfter(/databases/$(database)/documents/sessions/$(sessionId))
        && getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherUid == request.auth.uid;

      allow update: if false;

      allow delete: if isValidId(sessionId)
        && isTeacher()
        && existing().teacherUid == request.auth.uid;
    }

    match /attendance/{recordId} {
      // Students can read only their own attendance (and safely check non-existence of their own deterministic ID);
      // teachers can read attendance for their sessions.
      allow get: if isValidId(recordId)
        && isSignedIn()
        && (
          (resource == null
            && recordId.size() > request.auth.uid.size() + 1
            && recordId[recordId.size() - request.auth.uid.size() - 1 : recordId.size()] == ('_' + request.auth.uid))
          || (resource != null && (existing().studentUid == request.auth.uid || existing().teacherUid == request.auth.uid))
        );

      allow list: if isSignedIn()
        && (existing().studentUid == request.auth.uid || existing().teacherUid == request.auth.uid);

      // Deterministic document ID (${sessionId}_${studentUid}) prevents duplicate scans.
      // Rules verify student role, active status, server-side expiry timestamp, server timestamp,
      // and server-side SHA-256 hash of qrToken against the student-unreadable sessionSecrets doc.
      allow create: if isValidId(recordId)
        && isStudent()
        && recordId == (incoming().sessionId + '_' + request.auth.uid)
        && incoming().studentUid == request.auth.uid
        && isValidAttendanceRecord(incoming())
        && exists(/databases/$(database)/documents/sessions/$(incoming().sessionId))
        && exists(/databases/$(database)/documents/sessionSecrets/$(incoming().sessionId))
        && verifyAttendanceSessionAndToken(incoming());

      allow update, delete: if false;
    }
  }
}
